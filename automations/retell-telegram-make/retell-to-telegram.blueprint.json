{
    "name": "Retell AI -> Telegram (call_ended)",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 1000001,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "Retell AI Webhook"
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "label": "Retell AI Webhook",
                            "data": {
                                "editable": "true"
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ],
                "interface": [
                    {
                        "name": "event",
                        "type": "text",
                        "label": "event"
                    },
                    {
                        "name": "call",
                        "type": "collection",
                        "label": "call",
                        "spec": [
                            { "name": "call_id", "type": "text", "label": "call_id" },
                            { "name": "call_type", "type": "text", "label": "call_type" },
                            { "name": "agent_id", "type": "text", "label": "agent_id" },
                            { "name": "call_status", "type": "text", "label": "call_status" },
                            { "name": "direction", "type": "text", "label": "direction" },
                            { "name": "from_number", "type": "text", "label": "from_number" },
                            { "name": "to_number", "type": "text", "label": "to_number" },
                            { "name": "start_timestamp", "type": "number", "label": "start_timestamp" },
                            { "name": "end_timestamp", "type": "number", "label": "end_timestamp" },
                            { "name": "duration_ms", "type": "number", "label": "duration_ms" },
                            { "name": "disconnection_reason", "type": "text", "label": "disconnection_reason" },
                            { "name": "transcript", "type": "text", "label": "transcript" },
                            { "name": "recording_url", "type": "text", "label": "recording_url" }
                        ]
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "telegram:SendReplyMessage",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 1000002
            },
            "filter": {
                "name": "Solo call_ended",
                "conditions": [
                    [
                        {
                            "a": "{{1.event}}",
                            "b": "call_ended",
                            "o": "text:equal"
                        }
                    ]
                ]
            },
            "mapper": {
                "chatId": "PON_AQUI_TU_CHAT_ID",
                "text": "📞 Llamada finalizada (Retell AI)\n\nCall ID: {{1.call.call_id}}\nAgente: {{1.call.agent_id}}\nDireccion: {{1.call.direction}}\nDe: {{1.call.from_number}}\nA: {{1.call.to_number}}\nEstado: {{1.call.call_status}}\nMotivo desconexion: {{1.call.disconnection_reason}}\nDuracion (s): {{formatNumber((1.call.end_timestamp - 1.call.start_timestamp) / 1000; 0; \".\"; \"\")}}\n\n📝 Transcripcion:\n{{substring(1.call.transcript; 0; 3500)}}",
                "silent": false,
                "parseMode": "",
                "disableWebPagePreview": true
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0,
                    "name": "Enviar a Telegram"
                },
                "restore": {
                    "expect": {
                        "parseMode": {
                            "label": "Empty (plain text)"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "Telegram Bot connection",
                            "data": {
                                "scoped": "true",
                                "connection": "telegram"
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:telegram",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "chatId",
                        "type": "text",
                        "label": "Chat ID",
                        "required": true
                    },
                    {
                        "name": "text",
                        "type": "text",
                        "label": "Text",
                        "required": true
                    },
                    {
                        "name": "parseMode",
                        "type": "select",
                        "label": "Parse mode",
                        "validate": {
                            "enum": ["Markdown", "MarkdownV2", "HTML"]
                        }
                    },
                    {
                        "name": "silent",
                        "type": "boolean",
                        "label": "Disable Notifications"
                    },
                    {
                        "name": "disableWebPagePreview",
                        "type": "boolean",
                        "label": "Disable link previews"
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu2.make.com",
        "notes": []
    }
}
